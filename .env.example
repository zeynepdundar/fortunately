# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Neon). Pooled connection string.
DATABASE_URL=

# Firecrawl, used server-side to turn job URLs into markdown.
FIRECRAWL_API_KEY=

# Demo mode: server-side key used only when a visitor has no key of their own.
# Leave empty to disable live demo runs (samples still work).
DEMO_PROVIDER=anthropic
DEMO_MODEL=
DEMO_ANTHROPIC_API_KEY=
DEMO_OPENAI_API_KEY=
DEMO_RUNS_PER_IP_PER_DAY=3
DEMO_DAILY_BUDGET_USD=1
